[package]
name = "ckb-node-shield"
description = "Sandbox CKB full nodes (ckb), Fiber nodes (fnn), CKB light clients (ckb-light-client) and Node.js stratum mining proxies: no program execution, no writes to their config, binaries or the host's login and boot files."
license = "GPL-2.0 OR BSD-2-Clause"
authors = ["Authors of shirudo", "Wyltek Industries"]

[[files]]
source = "sandbox.toml"

[[files]]
source = "gen_policy.py"

[[upatches]]
source = "ckb-node-shield.bpf.c"

[[upatches.rodata]]
symbol = "sandbox_policy"
input = "sandbox.toml"
generator = ["python3", "gen_policy.py"]
update = ["python3", "gen_policy.py"]

# The executables that put a task in the ckb sandbox. Add the path of
# your own install here: a path that does not exist on a host is skipped
# with a warning in the journal.
[[upatches.policy]]
id = "ckb"
bit = 0x1
paths = ["/usr/local/bin/ckb", "/usr/bin/ckb", "/opt/ckb/ckb", "/usr/local/ckb/ckb"]

# The executables that put a task in the fnn (Fiber node) sandbox.
[[upatches.policy]]
id = "fnn"
bit = 0x2
paths = ["/usr/local/bin/fnn", "/usr/bin/fnn", "/opt/fiber/fnn", "/opt/fnn/fnn"]

# The executables that put a task in the ckb-light (light client) sandbox.
[[upatches.policy]]
id = "ckb-light"
bit = 0x4
paths = ["/usr/local/bin/ckb-light-client", "/usr/bin/ckb-light-client", "/opt/ckb-light-client/ckb-light-client", "/opt/ckb-light/ckb-light-client"]

# The executables that put a task in the stratum-proxy (mining proxy)
# sandbox. The proxy is a Node.js script, so the label goes on the node
# INTERPRETER that runs it. Never list /usr/bin/node here: that would
# sandbox every Node.js program on the host. Give the proxy its own copy
# of node at one of these paths and run it with that (see README).
[[upatches.policy]]
id = "stratum-proxy"
bit = 0x8
paths = ["/opt/ckb-stratum-proxy/node", "/usr/local/lib/ckb-stratum-proxy/node"]

[upatches.tree]
id = "ckb-node-shield"
